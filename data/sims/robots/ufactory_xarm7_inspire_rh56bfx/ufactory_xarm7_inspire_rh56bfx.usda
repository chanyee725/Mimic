#usda 1.0
(
    defaultPrim = "ufactory_xarm7_inspire_rh56bfx"
    doc = "ufactory_xarm7 with inspire_rh56bfx on link_eef; generated by scripts/compose-sim-robot.py"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ufactory_xarm7_inspire_rh56bfx" (
    prepend references = @../ufactory_xarm7/ufactory_xarm7.usd@
)
{
    over "joints"
    {
        over "joint1"
        {
            float state:angular:physics:position = 0
        }

        over "joint2"
        {
            float state:angular:physics:position = -47.5
        }

        over "joint3"
        {
            float state:angular:physics:position = 0
        }

        over "joint4"
        {
            float state:angular:physics:position = 0
        }

        over "joint5"
        {
            float state:angular:physics:position = 0
        }

        over "joint6"
        {
            float state:angular:physics:position = 0
        }

        over "joint7"
        {
            float state:angular:physics:position = 9.6
        }
    }

    def Xform "tool" (
        prepend references = @../../tools/inspire_rh56bfx/inspire_rh56bfx.usda@
    )
    {
        quatf xformOp:orient = (-0.0000036358833, 1, 0, 0)
        double3 xformOp:translate = (0.20600061118602753, 0.000002825486035362701, 0.1204998716711998)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        over "Physics"
        {
            over "FixedJoint" (
                active = false
            )
            {
            }
        }

        over "r_base_link" (
            delete apiSchemas = ["PhysicsArticulationRootAPI"]
        )
        {
        }

        over "PhysicsScene" (
            active = false
        )
        {
        }
    }

    def PhysicsFixedJoint "tool_joint"
    {
        rel physics:body0 = </ufactory_xarm7_inspire_rh56bfx/link7>
        rel physics:body1 = </ufactory_xarm7_inspire_rh56bfx/tool/r_base_link>
        point3f physics:localPos0 = (2.7755576e-17, 0, 0)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
    }
}

