# Copy to .env (git-ignored, mode 600) and fill in. Environment variables win over this file.

# --- Secrets (the backend's Settings page edits these lines; the API shows only the last 4 chars) ---
# Hugging Face token for dataset / model uploads (also read by huggingface_hub)
HF_TOKEN=
# RunPod API key for cloud training
RUNPOD_API_KEY=
# Weights & Biases API key for training logs
WANDB_API_KEY=
# Slack incoming webhook URL for notifications
SLACK_WEBHOOK_URL=

# --- Backend config (VLA_*; relative paths start at the repo root) ---
# Station data folder (settings/, rigs/, ...); default: data
# VLA_DATA_DIR=data
# Isaac Sim environments folder (one sub-folder per environment); default: sim/envs
# VLA_SIM_ENVS_DIR=sim/envs
# Time zone for dates shown in the station; default: Asia/Seoul
# VLA_TIMEZONE=Asia/Seoul
# Origins allowed to call the API (JSON list); default: ["http://localhost:5173"]
# VLA_CORS_ORIGINS=["http://localhost:5173"]
