#usda 1.0
(
    defaultPrim = "tray"
    doc = """Static 16 x 12 cm tray with 3 cm walls, a place target. Origin at its bottom, centred."""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "tray" (
    kind = "component"
)
{
    def Cube "floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.2, 0.36, 0.62)]
        double3 xformOp:translate = (0, 0, 0.0025)
        float3 xformOp:scale = (0.16, 0.12, 0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "wall_n" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.2, 0.36, 0.62)]
        double3 xformOp:translate = (0, 0.0575, 0.015)
        float3 xformOp:scale = (0.16, 0.005, 0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "wall_s" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.2, 0.36, 0.62)]
        double3 xformOp:translate = (0, -0.0575, 0.015)
        float3 xformOp:scale = (0.16, 0.005, 0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "wall_e" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.2, 0.36, 0.62)]
        double3 xformOp:translate = (0.0775, 0, 0.015)
        float3 xformOp:scale = (0.005, 0.11, 0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "wall_w" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.2, 0.36, 0.62)]
        double3 xformOp:translate = (-0.0775, 0, 0.015)
        float3 xformOp:scale = (0.005, 0.11, 0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
