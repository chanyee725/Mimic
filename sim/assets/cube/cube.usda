#usda 1.0
(
    defaultPrim = "cube"
    doc = """Graspable 4 cm cube, 50 g rigid body. Origin at its bottom face, centred."""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "cube" (
    kind = "component"
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.05

    def Cube "geom" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 0.04
        color3f[] primvars:displayColor = [(0.8, 0.12, 0.1)]
        double3 xformOp:translate = (0, 0, 0.02)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
